{
  "schema_version": 1,
  "note": "Starting points only. The market-map workflow checks which sources work for the user's field and region and records them in market.json. Automating a site can break its terms; platform automation is opt-in and human-paced.",
  "access_kinds": {
    "public-api": "Public job-board API, no login (preferred where available).",
    "browser": "The user's own logged-in browser session through the browser MCP server.",
    "jobfather-naukri": "The Jobfather's own Naukri MCP server (opt-in, rate-limited, human confirm before applying).",
    "linkedin-mcp": "Third-party LinkedIn MCP server (opt-in; uses an anti-detection browser library; read tools only).",
    "manual": "The user browses and pastes links or listings for intake."
  },
  "global": [
    {
      "id": "linkedin",
      "name": "LinkedIn Jobs and hiring posts",
      "kind": "network-board",
      "access": [
        "browser",
        "linkedin-mcp",
        "manual"
      ],
      "notes": "Location filters are unreliable: put the city in the keywords and check every JD. Hiring posts often name a contact."
    },
    {
      "id": "company-careers",
      "name": "Company career pages on Greenhouse, Lever, Ashby, Workable, SmartRecruiters",
      "kind": "ats-boards",
      "access": [
        "public-api",
        "browser"
      ],
      "notes": "Best source for target companies; public board APIs need no login."
    },
    {
      "id": "indeed",
      "name": "Indeed",
