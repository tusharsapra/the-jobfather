{
  "mcpServers": {
    "browser": {
      "command": "uvx",
      "type": "stdio",
      "args": [
        "--from",
        "git+https://github.com/tusharsapra/the-jobfather@d2c046b571aee381d5e1b0c792b22a3e04e0b8cd#subdirectory=packages/jobfather-mcp",
        "jobfather-browser"
      ],
      "env": {
        "UV_HTTP_TIMEOUT": "300"
      }
    },
    "naukri": {
      "command": "uvx",
      "type": "stdio",
      "args": [
        "--from",
        "git+https://github.com/tusharsapra/the-jobfather@d2c046b571aee381d5e1b0c792b22a3e04e0b8cd#subdirectory=packages/jobfather-mcp",
        "jobfather-naukri"
      ],
      "env": {
        "UV_HTTP_TIMEOUT": "300"
      }
    }
  }
}
