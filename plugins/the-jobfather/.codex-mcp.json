{
  "mcpServers": {
    "jobfather_browser": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/tusharsapra/the-jobfather@4e1fb31154e6017e7118598ee22f7b888d03d118#subdirectory=packages/jobfather-mcp",
        "jobfather-browser"
      ],
      "env": {
        "UV_HTTP_TIMEOUT": "300"
      },
      "env_vars": [
        "JOBFATHER_HOME"
      ],
      "startup_timeout_sec": 120,
      "tool_timeout_sec": 120
    }
  }
}
