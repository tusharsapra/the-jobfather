{
  "mcpServers": {
    "jobfather_browser": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/tusharsapra/the-jobfather@76a778b8b18ac2c61c189f95f994724c785d5abb#subdirectory=packages/jobfather-mcp",
        "jobfather-browser"
      ],
      "env": {
        "UV_HTTP_TIMEOUT": "300"
      },
      "env_vars": [
        "JOBFATHER_HOME"
      ],
      "startup_timeout_sec": 120,
      "tool_timeout_sec": 120
    },
    "jobfather_naukri": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/tusharsapra/the-jobfather@76a778b8b18ac2c61c189f95f994724c785d5abb#subdirectory=packages/jobfather-mcp",
        "jobfather-naukri"
      ],
      "env": {
        "UV_HTTP_TIMEOUT": "300"
      },
      "env_vars": [
        "JOBFATHER_HOME"
      ],
      "startup_timeout_sec": 120,
      "tool_timeout_sec": 420,
      "enabled_tools": [
        "naukri_status",
        "naukri_login",
        "naukri_search_jobs",
        "naukri_recommended_jobs",
        "naukri_get_job",
        "naukri_similar_jobs",
        "naukri_saved_jobs",
        "naukri_my_profile",
        "naukri_prepare_apply",
        "naukri_apply",
        "naukri_close"
      ],
      "tools": {
        "naukri_apply": {
          "approval_mode": "prompt"
        }
      }
    }
  }
}
