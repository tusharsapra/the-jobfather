# Allowlist: ignore everything at the top level, then allow known paths.
/*
!/.gitignore
!/.gitattributes
!/LICENSE
!/README.md
!/CHANGELOG.md
!/PRIVACY.md
!/THIRD-PARTY.md
!/SECURITY.md
!/CONTRIBUTING.md
!/AGENTS.md
!/RELEASING.md
!/.claude-plugin/
!/.cursor-plugin/
!/.agents/
!/.github/
!/dev/
!/tests/
!/examples/
!/packages/
!/plugins/
/.agents/*
!/.agents/plugins/
/.agents/plugins/*
!/.agents/plugins/marketplace.json

# Never commit runtime state, personal artefacts or binaries, at any depth.
**/.state/
**/__pycache__/
**/*.py[cod]
**/.venv/
**/node_modules/
**/.DS_Store
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.pdf
**/*.png
**/*.jpg
**/*.jpeg
**/*.gif
**/*.webp
**/*.heic
**/*.zip
**/*.xlsx
**/*.xls
**/*.doc
**/*.docx
**/*.pptx
**/*.har
**/*.eml
**/*.mbox
**/*.sqlite
**/*.db
**/*.log
**/*.bak
**/.context.lock
**/*.lock.json
**/raw-captures/
/dev/denylist*
